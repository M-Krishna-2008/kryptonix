# ============================================================================
# KRYPTØNIX — STAR COMMAND ENVIRONMENT CONFIGURATION (.env.example)
# Copy this file to .env for local development. NEVER commit .env to Git.
# ============================================================================

# --- 1. SERVER-SIDE CONFIGURATION (Used by server.ts; never exposed to browser) ---
PORT=3000

# SESSION_SECRET: Secret key used by the backend to sign HMAC session tokens.
# Generate a random 64-char hex string in production.
SESSION_SECRET="REPLACE_WITH_RANDOM_64_CHAR_HEX_SECRET"

# KRYPTONIX_PIN_SALT & KRYPTONIX_PIN_HASH: Optional pre-computed scrypt salt & hash.
# If omitted, the server allows one-time PIN initialization and stores the salted
# hash in data/kryptonix-store.json.
KRYPTONIX_PIN_SALT=""
KRYPTONIX_PIN_HASH=""

# ALLOWED_ORIGIN: Origin allowed for CORS when frontend is hosted on GitHub Pages
# e.g., https://your-username.github.io
ALLOWED_ORIGIN="*"

# --- 2. FRONTEND / STATIC HOSTING CONFIGURATION (Publicly visible at build time) ---
# VITE_API_BASE_URL: Optional URL of your hosted Node/Express backend if frontend is
# deployed separately on GitHub Pages (leave empty when served from the same origin).
VITE_API_BASE_URL=""

# VITE_GOOGLE_APPS_SCRIPT_URL: Optional URL of your deployed Google Apps Script Web App
# (https://script.google.com/macros/s/.../exec) when using Google Sheets directly from GitHub Pages.
# Never place private secrets in VITE_ variables.
VITE_GOOGLE_APPS_SCRIPT_URL=""


