# ==============================================================================
# PS-05 Unified AI Forensics Platform - Environment Variables Template
# Copy this file to .env and adjust variables for custom deployments.
# ==============================================================================

# Gateway & Server Network Bindings
HOST=127.0.0.1
GATEWAY_PORT=8080

# Hardware Acceleration (auto | cuda | cpu)
DEVICE_PREFERENCE=auto

# Offline Execution Mode (1 = Disable all telemetry and online phone-homes)
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# Execution Timeout Settings (seconds)
ANALYSIS_TIMEOUT_AUDIO=120
ANALYSIS_TIMEOUT_IMAGE=60
ANALYSIS_TIMEOUT_FORGERY=120
ANALYSIS_TIMEOUT_CCTV=300

# File Upload Max Constraints (bytes)
MAX_UPLOAD_SIZE_BYTES=524288000
