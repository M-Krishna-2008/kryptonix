{
  "platform": {
    "name": "Unified AI Forensics Platform",
    "version": "1.0.0",
    "gateway_default_port": 8080,
    "host": "127.0.0.1"
  },
  "modules": [
    {
      "id": "ai_aud",
      "display_name": "Audio Deepfake & Tamper Detection",
      "short_name": "Audio",
      "description": "Acoustic authenticity verification using Wav2Vec2/XLS-R 300M and AASIST spectral graph attention network.",
      "cwd": "ai_aud",
      "python_version": "3.10.11",
      "venv_python": "ai_aud/.venv/Scripts/python.exe",
      "default_port": 8001,
      "proxy_prefix": "/api/aud",
      "upstream_prefix": "/api/audio_forensics",
      "health_endpoint": "/api/audio_forensics/health",
      "analyze_endpoint": "/api/audio_forensics/analyze",
      "progress_endpoint": "/api/audio_forensics/progress/{job_id}",
      "artifacts_endpoint": "/api/audio_forensics/artifacts",
      "form_field": "file",
      "allowed_extensions": [".wav", ".mp3", ".flac", ".ogg", ".m4a", ".aac"],
      "allowed_mime_types": ["audio/wav", "audio/x-wav", "audio/mpeg", "audio/flac", "audio/x-flac", "audio/ogg", "audio/mp4", "audio/x-m4a"],
      "max_upload_bytes": 524288000,
      "is_async_job": false,
      "forensic_type": "audio_logit",
      "metric_label": "Bona-Fide Logit",
      "score_direction": "higher_is_authentic",
      "score_tooltip": "Raw uncalibrated acoustic logit (higher = genuine human speech). Never interpret as a percentage or probability.",
      "thresholds": {
        "low_threshold": -3.7,
        "high_threshold": 1.5
      },
      "start_command": ["main_standalone.py"],
      "model_files": [
        {
          "name": "XLS-R 300M Base",
          "path": "ai_aud/audio_forensics/models/xlsr2_300m.pt",
          "size_bytes": 3808868242,
          "sha256": "b08927597f2c9eb2ebd7dcc3ac78ee4b5f6021cbac4b3a6c5a9deec445d80ed9"
        },
        {
          "name": "W2V2-AASIST Backend",
          "path": "ai_aud/audio_forensics/models/LA_model.pth",
          "size_bytes": 1271633441,
          "sha256": "bd6f36097259fe54e7004eb983651e5304d807be81156dbd04faccb70d91e10c"
        }
      ]
    },
