<Configuration>
  <VGpu>Default</VGpu>
  <Networking>Default</Networking>
  <MappedFolders>
    <MappedFolder>
      <HostFolder>C:\Users\Subha\.gemini\antigravity\scratch\image_forgery</HostFolder>
      <SandboxFolder>C:\image_forgery_readonly</SandboxFolder>
      <ReadOnly>true</ReadOnly>
    </MappedFolder>
  </MappedFolders>
  <LogonCommand>
    <Command>powershell -NoProfile -ExecutionPolicy Bypass -Command "Write-Host '====================================================='; Write-Host '  PS-05 Image Forgery Clean-Room Sandbox Test'; Write-Host '====================================================='; Write-Host '[1/2] Copying pristine files from read-only host share to ephemeral sandbox drive...'; Copy-Item -Path 'C:\image_forgery_readonly' -Destination 'C:\image_forgery' -Recurse; Set-Location 'C:\image_forgery'; Write-Host '[2/2] Launching run_platform.bat in clean environment...'; cmd.exe /k .\run_platform.bat"</Command>
  </LogonCommand>
</Configuration>
