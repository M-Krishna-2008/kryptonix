<Configuration>
  <VGpu>Default</VGpu>
  <Networking>Default</Networking>
  <MappedFolders>
    <MappedFolder>
      <!-- Change HostFolder to your local path if moved to another laptop -->
      <HostFolder>C:\Users\Grish ragav\Downloads\yolo project</HostFolder>
      <SandboxFolder>C:\ai_cctv_detection</SandboxFolder>
      <ReadOnly>false</ReadOnly>
    </MappedFolder>
  </MappedFolders>
  <LogonCommand>
    <Command>cmd.exe /k "cd /d C:\ai_cctv_detection &amp;&amp; check_system.bat &amp;&amp; run_platform.bat /dryrun"</Command>
  </LogonCommand>
</Configuration>
