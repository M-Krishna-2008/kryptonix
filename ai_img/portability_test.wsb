<Configuration>
  <!-- 
    PS-05 AI Image Detection - Windows Sandbox Portability Test Specification
    Requirement: Windows 10/11 Pro, Enterprise, or Education with Windows Sandbox enabled.
    Usage: Double-click portability_test.wsb to launch a completely pristine disposable Windows VM.
  -->
  <Networking>Default</Networking>
  <MappedFolders>
    <MappedFolder>
      <HostFolder>C:\Users\galah\Downloads\bihar\ai_img</HostFolder>
      <SandboxFolder>C:\ai_image_detection</SandboxFolder>
      <ReadOnly>false</ReadOnly>
    </MappedFolder>
  </MappedFolders>
  <LogonCommand>
    <Command>cmd.exe /k "cd /d C:\ai_image_detection &amp;&amp; check_system.bat /nopause &amp;&amp; run_platform.bat"</Command>
  </LogonCommand>
</Configuration>
