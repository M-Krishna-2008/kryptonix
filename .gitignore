# ==============================================================================
# PS-05 Unified AI Forensics Platform - .gitignore
# Strict repository hygiene: excludes environments, models, caches, uploads & raw media
# ==============================================================================

# Virtual Environments
.venv/
*/.venv/
*/*/.venv/
venv/
env/
test_venv/
*/test_venv/

# Byte-compiled / Python caches
__pycache__/
*/__pycache__/
*/*/__pycache__/
*/*/*/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
*/.pytest_cache/
.mypy_cache/
.ruff_cache/

# Runtime Logs, Ports, PIDs & Temp
logs/
*/logs/
*/*logs/
runtime/*.json
runtime/*.txt
*.log
*.tmp
*.bak
*_old

# User Uploads, Evidence, Caches & Generated Artifacts
uploads/
*/uploads/
*/*uploads/
artifacts/
*/artifacts/
*/*artifacts/
cache/
*/cache/
*/*cache/
tampered_out/
*/tampered_out/
gateway/runtime/uploads/

# Raw Datasets & User Media
data/
*/data/
data_raw/
*/data_raw/
data_audio/
*/data_audio/
data_diagnosis/
*/data_diagnosis/
*.mp3
*.wav
*.flac
*.ogg
*.m4a
*.mp4
*.avi
*.mkv
*.mov

# Keep test fixture samples explicitly tracked
!ai_aud/audio_forensics/tests/samples/**
!ai_cctv/tests/**
!ai_img/ai_image_detection/tests/samples/**
!image_forgery/image_forgery/tests/samples/**
!image_forgery/image_forgery/tests/calibration/**

# Large Binary Model Weights & Checkpoints (>25 MB downloaded at setup)
*.pt
*.pth
*.pth.tar
*.onnx
*.ckpt
*.safetensors
*.bin
*.tar
*.gz
*.7z
*.zip
*.whl

# EXCEPTION: Tracked project artifacts (<25 MB trained weights)
!ai_cctv/ai_cctv_detection/models/best.pt
!ai_img/ai_image_detection/models/fc_weights.pth

# Keep empty folder structures intact via .gitkeep
!.gitkeep
!*/.gitkeep
!*/*/.gitkeep
!*/*/*/.gitkeep

# Environment variables & Local configuration
.env
*.env.local

# Local scripts not part of repo
make_offline_bundle.bat

# Operating System & IDE junk
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/
.idea/
.vscode/
*.swp
*.swo
*~
